# Пример переменных окружения для backend (B6). Скопируйте в .env и подставьте значения.
# .env в Git не попадает (см. .gitignore). Перед запуском экспортируйте переменные,
# например: export $(grep -v '^#' .env | xargs) — или задайте их в своей оболочке.

# Токен администратора для POST/PATCH /api/products (B6).
# Проверяется по заголовку X-Admin-Token. НЕ встраивается в JavaScript сайта.
ADMIN_TOKEN=

# Путь к SQLite-базе (B4). Создаётся автоматически с тестовыми товарами.
SHOP_DB=shop.db

# Адрес и порт сервера (сайт и API с одного адреса).
HOST=127.0.0.1
PORT=8000
